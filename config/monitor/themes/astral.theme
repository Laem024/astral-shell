# Astral resource monitor theme for btop (dark, default).
# Colours come from the dark palette in docs/design-system.md.
# For light mode, set color_theme = "astral-light" in btop.conf.

theme[main_bg]="#0E1113"
theme[main_fg]="#E7ECE9"
theme[title]="#E7ECE9"
theme[hi_fg]="#7FD0BF"
theme[selected_bg]="#171C1F"
theme[selected_fg]="#7FD0BF"
theme[inactive_fg]="#8D9994"
theme[graph_text]="#E7ECE9"
theme[meter_bg]="#171C1F"
theme[proc_misc]="#7FD0BF"
theme[cpu_box]="#7FD0BF"
theme[mem_box]="#A9B5D9"
theme[net_box]="#7FD0BF"
theme[proc_box]="#A9B5D9"
theme[div_line]="#8D9994"
theme[followed_bg]="#A9B5D9"
theme[followed_fg]="#0E1113"
theme[proc_banner_bg]="#7FD0BF"
theme[proc_banner_fg]="#0E1113"
theme[proc_follow_bg]="#A9B5D9"
theme[proc_pause_bg]="#E5B873"
theme[temp_start]="#7FD0BF"
theme[temp_mid]="#E5B873"
theme[temp_end]="#F08C7B"
