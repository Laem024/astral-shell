# Astral resource monitor theme for btop (light).
# Colours come from the light palette in docs/design-system.md.
# To use it, set color_theme = "astral-light" in btop.conf.

theme[main_bg]="#EEF2EF"
theme[main_fg]="#141B1D"
theme[title]="#141B1D"
theme[hi_fg]="#17675A"
theme[selected_bg]="#FBFCFA"
theme[selected_fg]="#17675A"
theme[inactive_fg]="#5A6764"
theme[graph_text]="#141B1D"
theme[meter_bg]="#FBFCFA"
theme[proc_misc]="#17675A"
theme[cpu_box]="#17675A"
theme[mem_box]="#3B4A7A"
theme[net_box]="#17675A"
theme[proc_box]="#3B4A7A"
theme[div_line]="#5A6764"
theme[followed_bg]="#3B4A7A"
theme[followed_fg]="#FBFCFA"
theme[proc_banner_bg]="#17675A"
theme[proc_banner_fg]="#FBFCFA"
theme[proc_follow_bg]="#3B4A7A"
theme[proc_pause_bg]="#8A5B16"
theme[temp_start]="#17675A"
theme[temp_mid]="#8A5B16"
theme[temp_end]="#A9361F"
