#!/usr/bin/env bash
set -euo pipefail
[[ ${LC_ALL:-} == C ]] || exit 99
log=${VPN_FIXTURE_LOG:?}
printf ' %s\n' "$*" >> "$log"
mode=normal
[[ ! -f "$log.mode" ]] || read -r mode < "$log.mode"
args=" $* "
case $args in
  *' test-mode '*)
    printf '%s\n' "${!#}" > "$log.mode" ;;
  *' connection show uuid vpn-id '* | *' connection show uuid office2-id '*)
    printf 'org.freedesktop.NetworkManager.openvpn\n' ;;
  *' connection show uuid other-id '*)
    printf 'org.freedesktop.NetworkManager.vpnc\n' ;;
  *' connection show uuid '*)
    printf '\n' ;;
  *' connection show '*)
    if [[ -f $log.up ]]; then wg=yes; else wg=no; fi
    printf 'wg0:wireguard:wg-id:%s\n' "$wg"
    [[ -f $log.deleted ]] || printf 'Office:vpn:vpn-id:no\n'
    printf 'Ignored:vpn:other-id:no\nHome:802-11-wireless:wifi-id:no\nCable:802-3-ethernet:eth-id:no\n'
    [[ ! -f $log.imported ]] || printf 'Imported:wireguard:imported-id:no\n'
    [[ ! -f $log.imported2 ]] || printf 'Office2:vpn:office2-id:no\n' ;;
  *' connection up uuid wg-id '*) : > "$log.up" ;;
  *' connection down uuid wg-id '*) rm -f "$log.up" ;;
  *' connection import type wireguard file /tmp/fixture.conf '*) : > "$log.imported" ;;
  *' connection import type openvpn file /tmp/office.ovpn '*) : > "$log.imported2" ;;
  *' connection import '*) [[ $mode != import-fail ]] || exit 10 ;;
  *' connection delete uuid vpn-id '*) : > "$log.deleted" ;;
  *' connection up '* | *' connection down '* | *' connection delete '*) ;;
  *) exit 96 ;;
esac
